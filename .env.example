# Copied to .env by install.sh. Edit, then: docker compose up -d
WEB_PORT=5000
WEB_BIND=0.0.0.0          # 127.0.0.1 = only this server (use an SSH tunnel / reverse proxy)
LOGIN_USER=admin
LOGIN_PASSWORD=admin123   # change this, then: docker compose up -d
# Tuning (see README "Speed and accuracy"). This server is meant to run the cameras only.
INOUT_FPS=10              # line-count checks per second per In/Out camera
ACTIVE_CAMERA_COUNT=7     # only Cameras 01–07 run; set higher when more cameras are connected
GATE_IMGSZ=960            # detector size for the gate counters (larger finds far-away people, costs CPU)
CROWD_INTERVAL_S=30       # head count per camera every 30 s
DETECT_INTERVAL_S=30
INOUT_WORKERS=            # blank = auto, at most 6 workers on a 32 GB host
CROWD_WORKERS=            # blank = auto, at most 4 model processes on a 32 GB host
WEB_THREADS=64            # raise only if many viewers saturate the HLS request pool
# Live video (WebRTC). Browsers must reach this server on UDP/TCP 8189. List the address(es) they use, comma separated
# (LAN IP, Tailscale IP, DNS name); install.sh fills in this machine's addresses.
WEBRTC_HOSTS=127.0.0.1
